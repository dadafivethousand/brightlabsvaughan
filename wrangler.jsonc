{
  // Workers Static Assets, not Pages — and the reason is DNS, not preference.
  //
  // Pages custom domains do not create their own DNS record when they are
  // attached over the API: they sit at "pending" until something writes the
  // CNAME, and the wrangler OAuth token on this machine has `zone:read` and no
  // DNS write scope at all (`wrangler login` cannot grant one — DNS write is
  // not a scope wrangler asks for). A WORKERS custom domain is provisioned by
  // the Workers service itself under `workers_routes:write`, which the token
  // does have, so it creates the record and orders the certificate on its own.
  //
  // Same static files either way. There is no `main`, because an assets-only
  // Worker does not need a script.
  //
  // The directory is `./out` now, not `./public`: the site is a Next app built
  // with `output: "export"`, so `next build` writes finished HTML there and
  // this Worker uploads it unchanged. That is the ENTIRE deploy-side cost of
  // the move to Next — the Worker, the routes and the DNS story above are
  // untouched, which is why the export was chosen over @opennextjs/cloudflare.
  "name": "brightlabsvaughan",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./out",
    // 404-page, not single-page-application: an exported Next build emits a
    // real out/404.html from app/not-found, and SPA handling would serve
    // index.html for every miss instead — a wrong URL would silently render
    // the home page with a 200.
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "brightlabsvaughan.com", "custom_domain": true },
    { "pattern": "www.brightlabsvaughan.com", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
